{
  "components": {
    "schemas": {
      "AccessTokenResponse": {
        "additionalProperties": false,
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "format": "int64",
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          },
          "refreshToken": {
            "type": "string"
          },
          "tokenType": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "accessToken",
          "expiresIn",
          "refreshToken"
        ],
        "type": "object"
      },
      "CompleteAccountRequest": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "code",
          "password"
        ],
        "type": "object"
      },
      "Credentials": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "CsrfToken": {
        "additionalProperties": false,
        "properties": {
          "requestToken": {
            "type": "string"
          }
        },
        "required": [
          "requestToken"
        ],
        "type": "object"
      },
      "EmailRequest": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "type": "object"
      },
      "MemberList": {
        "additionalProperties": false,
        "properties": {
          "members": {
            "items": {
              "$ref": "#/components/schemas/MemberProfile"
            },
            "type": "array"
          }
        },
        "required": [
          "members"
        ],
        "type": "object"
      },
      "MemberProfile": {
        "additionalProperties": false,
        "properties": {
          "active": {
            "type": "boolean"
          },
          "displayName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "isAccountAdministrator": {
            "type": "boolean"
          },
          "isEmployee": {
            "type": "boolean"
          },
          "isManager": {
            "type": "boolean"
          },
          "memberId": {
            "format": "uuid",
            "type": "string"
          },
          "organizationId": {
            "format": "uuid",
            "type": "string"
          },
          "organizationName": {
            "type": "string"
          }
        },
        "required": [
          "memberId",
          "organizationId",
          "organizationName",
          "displayName",
          "email",
          "active",
          "isEmployee",
          "isManager",
          "isAccountAdministrator"
        ],
        "type": "object"
      },
      "ProblemDetails": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "nullable": true,
            "type": "string"
          },
          "instance": {
            "nullable": true,
            "type": "string"
          },
          "status": {
            "format": "int32",
            "nullable": true,
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          },
          "title": {
            "nullable": true,
            "type": "string"
          },
          "type": {
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "ProvisionMemberRequest": {
        "additionalProperties": false,
        "properties": {
          "displayName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "isAccountAdministrator": {
            "type": "boolean"
          },
          "isEmployee": {
            "type": "boolean"
          },
          "isManager": {
            "type": "boolean"
          }
        },
        "required": [
          "email",
          "displayName",
          "isEmployee",
          "isManager",
          "isAccountAdministrator"
        ],
        "type": "object"
      },
      "RefreshRequest": {
        "additionalProperties": false,
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ],
        "type": "object"
      },
      "SetManagerRequest": {
        "additionalProperties": false,
        "properties": {
          "managerId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "managerId"
        ],
        "type": "object"
      },
      "UpdateMemberRequest": {
        "additionalProperties": false,
        "properties": {
          "active": {
            "type": "boolean"
          },
          "isAccountAdministrator": {
            "type": "boolean"
          },
          "isEmployee": {
            "type": "boolean"
          },
          "isManager": {
            "type": "boolean"
          }
        },
        "required": [
          "active",
          "isEmployee",
          "isManager",
          "isAccountAdministrator"
        ],
        "type": "object"
      },
      "WorkspaceInfo": {
        "additionalProperties": false,
        "properties": {
          "apiVersion": {
            "type": "string"
          },
          "planningTimeZones": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "productName": {
            "type": "string"
          },
          "serverTimeUtc": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "productName",
          "apiVersion",
          "serverTimeUtc",
          "planningTimeZones"
        ],
        "type": "object"
      }
    }
  },
  "info": {
