{$HO_PUBLIC_HOST} {
    # No public operational endpoints or OpenAPI, including descendants.
    @private path /health /health/* /openapi /openapi/*
    respond @private 404
    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000"
    }
    reverse_proxy app:8080
    # No access log: account routes must not spill private parameters into logs.
}
