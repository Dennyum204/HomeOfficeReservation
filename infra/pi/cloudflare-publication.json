{
  "publication_authorized": false,
  "tunnel_id": "cc5b6025-b9fc-4d54-9854-5ed3aee17cad",
  "zone_name": "ferbatech.com",
  "dns_record": {
    "type": "CNAME",
    "name": "homeoffice.ferbatech.com",
    "content": "cc5b6025-b9fc-4d54-9854-5ed3aee17cad.cfargotunnel.com",
    "proxied": true,
    "ttl": 1
  },
  "proposed_rules_by_phase": {
    "http_request_dynamic_redirect": [
      {
        "ref": "ho012_homeoffice_https",
        "description": "HomeOffice only: HTTPS redirect",
        "expression": "(http.host eq \"homeoffice.ferbatech.com\" and http.request.scheme eq \"http\")",
        "action": "redirect",
        "action_parameters": {
          "from_value": {
            "target_url": {
              "expression": "concat(\"https://homeoffice.ferbatech.com\", http.request.uri.path)"
            },
            "status_code": 308,
            "preserve_query_string": true
          }
        }
      }
    ],
    "http_request_cache_settings": [
      {
        "ref": "ho012_homeoffice_no_cache",
        "description": "HomeOffice only: no edge cache during pilot",
        "expression": "(http.host eq \"homeoffice.ferbatech.com\")",
        "action": "set_cache_settings",
        "action_parameters": {
          "cache": false
        }
      }
    ],
    "http_config_settings": [
      {
        "ref": "ho012_homeoffice_tls",
        "description": "HomeOffice only: strict transport",
        "expression": "(http.host eq \"homeoffice.ferbatech.com\")",
        "action": "set_config",
        "action_parameters": {
          "ssl": "strict"
        }
      },
      {
        "ref": "ho012_homeoffice_api_client",
        "description": "Native API clients; preserve WAF and DDoS",
        "expression": "(http.host eq \"homeoffice.ferbatech.com\" and starts_with(http.request.uri.path, \"/api/\"))",
        "action": "set_config",
        "action_parameters": {
          "bic": false
        }
      }
    ]
  }
}
