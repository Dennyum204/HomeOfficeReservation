{
    auto_https off
    admin off
}
https://localhost {
    tls /run/tls/server.pem /run/tls/server.key
    @private path /health /health/* /openapi /openapi/*
    respond @private 404
    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options DENY
    }
    reverse_proxy app:8080
}
