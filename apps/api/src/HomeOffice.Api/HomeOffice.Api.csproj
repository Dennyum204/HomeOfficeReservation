<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <UserSecretsId>HomeOfficeReservation-local-development</UserSecretsId>
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiGenerateDocumentsOptions>--document-name v1 --file-name homeoffice --openapi-version OpenApi3_0</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.11" PrivateAssets="all" />
    <ProjectReference Include="../HomeOffice.Application/HomeOffice.Application.csproj" />
    <ProjectReference Include="../HomeOffice.Infrastructure/HomeOffice.Infrastructure.csproj" />
  </ItemGroup>
</Project>
